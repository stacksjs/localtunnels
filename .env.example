# Porkbun DNS API credentials (used by `deploy:site` / src/cloud/deploy-site.ts).
# Create an API key pair at https://porkbun.com/account/api and enable API
# access on the relevant domain. Never commit the real values — keep them in
# an untracked `.env` (already in .gitignore).
PORKBUN_API_KEY=your-porkbun-api-key
PORKBUN_SECRET_KEY=your-porkbun-secret-key

# Hetzner Cloud API token, for `bun run deploy:vpn`.
#
# Create one at console.hetzner.com under Security > API tokens, with Read &
# Write — the deploy creates a server, opens a firewall port and attaches an
# SSH key, none of which a read-only token can do.
#
# Bun loads .env into the environment automatically, so a value here is enough;
# `deploy/config.ts` also accepts HETZNER_API_TOKEN, or falls back to a
# ts-cloud checkout's own .env.
HCLOUD_TOKEN=
