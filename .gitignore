# The VPN app bundle and its disk image.
/packages/buddyvpn/dist/

# stx's own compile cache, keyed by content hash. Tracked by accident, as it
# was once in packages/buddyvpn-mobile: it is rewritten on every build, so it
# turns every diff into churn, and a cache that travels between machines is
# worse than one rebuilt.
.stx/

# The dotenvx private key. `.env.production` is deliberately NOT ignored:
# its values are encrypted, and committing it is the point of the pattern.
.env.keys
