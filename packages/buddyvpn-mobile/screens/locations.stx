<script server>
/*
 * Server-side, on purpose, and this is the whole reason the list renders.
 *
 * A client `@for` cannot draw a list on the native renderer. The runtime
 * finds lists with `el.hasAttribute('@for')`, the translator drops that
 * attribute from the node (it reports it as `unread-event`), and a native
 * node does not implement `hasAttribute` in the first place — so the loop
 * matched nothing and the screen drew one empty row.
 *
 * Nothing is lost by moving it: the regions are fixed when the app is built.
 * Expanding here produces one real element per region, each carrying its own
 * bindings for the parts that do change — whether a tunnel is up, and whether
 * a region has a server behind it.
 */
import { REGIONS } from '../src/regions'
</script>

<script client>
import { haptics, navigation } from '../src/native'
import { REGIONS } from '../src/regions'
import { tunnel } from '../src/tunnel'

const snapshot = state(tunnel.snapshot())
onMount(() => tunnel.subscribe(next => snapshot.set(next)))

// Changing location while connected would mean tearing the tunnel down and
// building another, so the whole list is inert instead of offering taps that
// quietly do that.
const locked = () => snapshot().phase !== 'idle'

const choose = (id: string) => {
  if (locked()) return
  const region = REGIONS.find(entry => entry.id === id)
  if (!region?.exitIp) return
  haptics.selection()
  try {
    window.localStorage?.setItem('buddyvpn.region', id)
  }
  catch {
    // The choice still applies to this session; it just will not outlive it.
  }
  navigation.back()
}
</script>

<div class="flex flex-1 flex-col gap-4 bg-gray-100 px-5 pb-5 dark:bg-black">
  <h1 class="pt-4 text-2xl font-bold text-gray-900 dark:text-gray-50">Location</h1>

  @if(locked())
    <p class="rounded-xl border border-orange-300 bg-orange-100 p-3 text-center text-xs text-orange-700 dark:border-orange-700 dark:bg-orange-950 dark:text-orange-300" role="status">
      Disconnect to change location.
    </p>
  @endif

  <ul class="flex flex-col gap-2">
    @foreach(REGIONS as region)
      <li>
        <!--
          Bound, not interpolated, and bound inside the loop too: a `for` is a
          client binding, so its body is a template the runtime fills per item.
          A mustache in here is as literal as one anywhere else.
        -->
        <a
          class="flex w-full flex-row items-center gap-3 rounded-xl bg-white p-4 dark:bg-gray-900"
          :class="locked() ? 'flex w-full flex-row items-center gap-3 rounded-xl bg-gray-100 p-4 dark:bg-gray-800' : 'flex w-full flex-row items-center gap-3 rounded-xl bg-white p-4 dark:bg-gray-900'"
          @click="choose('{{ region.id }}')"
        >
          <!--
            Interpolated, not bound. `region` is the server loop's variable and
            does not exist at runtime, so `:text="region.badge"` evaluated to
            nothing and the rows drew empty. These values are fixed when the
            app is built, so baking them in is what they want anyway.
          -->
          <span class="shrink-0 text-xl">{{ region.badge }}</span>
          <span class="shrink-0 text-base font-medium text-gray-900 dark:text-gray-100">{{ region.country }}</span>
          <span class="flex-1 truncate text-sm text-gray-500 dark:text-gray-400">{{ region.city }}</span>
          <!-- A location with no server says so here, rather than looking
               available and failing on tap. -->
          @if(!region.exitIp)
            <span class="shrink-0 rounded-full bg-gray-200 px-2 py-1 text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300">No server yet</span>
          @endif
        </a>
      </li>
    @endforeach
  </ul>

  <p class="text-center text-xs text-gray-400">
    A location appears here once a server has been deployed behind it with
    bun run deploy:vpn.
  </p>
</div>
