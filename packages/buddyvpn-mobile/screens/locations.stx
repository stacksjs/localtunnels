<script server>
/*
 * Server-side, on purpose, and this is the whole reason the list renders.
 *
 * A client `@for` cannot draw a list on the native renderer. The runtime
 * finds lists with `el.hasAttribute('@for')`, the translator drops that
 * attribute from the node (it reports it as `unread-event`), and a native
 * node does not implement `hasAttribute` in the first place — so the loop
 * matched nothing and the screen drew one empty row.
 *
 * Nothing is lost by moving it: the regions are fixed when the app is built.
 * Expanding here produces one real element per region, each carrying its own
 * bindings for the parts that do change — whether a tunnel is up, and whether
 * a region has a server behind it.
 */
import { REGIONS } from '../src/regions'
</script>

<script client>
import { haptics, navigation } from '../src/native'
import { readPairing } from '../src/pairing'
import { REGIONS, writeRegion } from '../src/regions'
import { tunnel } from '../src/tunnel'

const snapshot = state(tunnel.snapshot())
/*
 * The one network this device holds a key for.
 *
 * A pairing is for a single region's coordinator, so every other location in
 * this list is one this device cannot join however deployed it is. Only true
 * of a real tunnel: the stand-in joins nothing and needs no key, so a
 * simulated build must not grey out locations that work perfectly well in it.
 */
const pairing = state(null)

onMount(() => {
  /*
   * The bar's title, which is otherwise this file's name.
   *
   * `routeName ?? appName` is the host's default, and the route name is the
   * screen's filename — so the picker opened with `locations` above it in
   * lowercase. Large, so it collapses into the bar as the list scrolls,
   * which is what replaces the heading this screen used to draw itself.
   */
  navigation.setOptions({ title: 'Location', largeTitle: true })
  void readPairing().then(found => pairing.set(found))
  return tunnel.subscribe(next => snapshot.set(next))
})

// Changing location while connected would mean tearing the tunnel down and
// building another, so the whole list is inert instead of offering taps that
// quietly do that.
const locked = () => snapshot().phase !== 'idle'

/** Whether this device could join a region at all, key included. */
const joinable = (id) => !tunnel.available() || pairing()?.region === id

const choose = (id: string) => {
  if (locked() || !joinable(id)) return
  const region = REGIONS.find(entry => entry.id === id)
  if (!region?.exitIp) return
  haptics.selection()
  /*
   * The tap that once did nothing at all.
   *
   * The row saved no choice and went nowhere, and `writeRegion` was
   * `undefined` when the handler reached it — a `ReferenceError` the event
   * dispatcher swallows, so there was no error anywhere to find. The cause
   * was never established; this exact code now compiles into the setup
   * (`writeRegion` is in the bundle's binding map) and works on a device.
   *
   * What is worth keeping from it: a handler that throws fails in complete
   * silence, so a control that does nothing is the symptom of an exception
   * you will never be shown. Log either side of a statement rather than
   * trusting that a clean compile means a bound name.
   */
  writeRegion(id)
  navigation.back()
}
</script>

<view class="flex-1 bg-gray-100 dark:bg-black">
  <scroll-view class="flex-1 px-4">
    <!-- No heading here: the title is the navigation bar's, set in setup. -->
    @if(locked())
      <view class="mb-3 mt-2 flex-row items-center gap-2 rounded-2xl border border-orange-300 bg-orange-100 p-3 dark:border-orange-700 dark:bg-orange-950">
        <icon class="i-lucide-lock shrink-0 text-base text-orange-700 dark:text-orange-300"></icon>
        <text class="flex-1 text-xs text-orange-700 dark:text-orange-300">Disconnect to change location.</text>
      </view>
    @endif

    <!--
      One rounded block of rows with hairlines between them, rather than a
      card per region. That is the inset grouped list iOS uses, and it is most
      of why a list reads as native.

      Every row carries the separator and the block clips it, so the first
      row's line sits under the rounded top edge where it is not seen. A
      per-row index would be tidier; the loop runs at render and does not
      expose one.
    -->
    <view class="mt-2 overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      @foreach(REGIONS as region)
        <!--
          Interpolated, not bound: `region` belongs to the render-time loop and
          does not exist at runtime, so a binding here evaluates to nothing.
          These values are fixed when the app is built, which is why the loop
          is server-side at all — a client `@for` cannot render a list on this
          renderer.
        -->
        <a
          class="flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 dark:border-gray-800"
          :class="(locked() || !joinable('{{ region.id }}')) ? 'flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 opacity-50 dark:border-gray-800' : 'flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 dark:border-gray-800'"
          @click="choose('{{ region.id }}')"
        >
          <icon class="i-lucide-map-pin shrink-0 text-base text-gray-400"></icon>
          <text class="shrink-0 text-base text-gray-900 dark:text-gray-100">{{ region.country }}</text>
          <text class="flex-1 text-right text-sm text-gray-500 dark:text-gray-400">{{ region.city }}</text>
          <!-- A location with no server says so here, rather than looking
               available and failing on tap. -->
          @if(region.exitIp)
            <icon class="i-lucide-chevron-right shrink-0 text-base text-gray-400"></icon>
          @endif
          @if(!region.exitIp)
            <text class="shrink-0 rounded-full bg-gray-200 px-2 py-1 text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300">No server yet</text>
          @endif
          <!--
            A deployed location this device holds no key for. Said on the row
            rather than left to fail at the tap: the server is there, and the
            reason this phone cannot use it has nothing to do with the server.

            Bound rather than conditioned. `@if(region.exitIp)` is the
            render-time loop's and bakes away correctly, but a client `@if`
            nested inside it never becomes a binding on this renderer — the
            badge compiled as plain text and would have shown on every row,
            always, which is worse than not showing at all. `:text` and
            `:class` do bind here, so the badge says nothing and draws
            nothing when the device can join.
          -->
          @if(region.exitIp)
            <text
              class="shrink-0"
              :class="joinable('{{ region.id }}') ? 'shrink-0' : 'shrink-0 rounded-full bg-orange-100 px-2 py-1 text-xs text-orange-700 dark:bg-orange-950 dark:text-orange-300'"
              :text="joinable('{{ region.id }}') ? '' : 'Not paired'"
            ></text>
          @endif
        </a>
      @endforeach
    </view>

    <text class="px-1 py-4 text-xs text-gray-500 dark:text-gray-400">
      A location appears here once a server has been deployed behind it with bun run deploy:vpn.
    </text>
  </scroll-view>
</view>
