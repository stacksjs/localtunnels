<script client>
import { deepLinks, haptics, navigation, whenNativeHost } from '../src/native'
import { applyPairingUrl, readPairing } from '../src/pairing'
import { readRegion, regionById, writeRegion } from '../src/regions'
import { readSettings } from '../src/settings'
import { coordinatorNotice, formatUptime, tunnel } from '../src/tunnel'

const region = state(readRegion())

const snapshot = state(tunnel.snapshot())
const native = state(false)
/*
 * What a scanned code did, if one was scanned.
 *
 * Shown until the next thing happens rather than dismissed on a timer: a
 * pairing is a thing somebody did on purpose, and a confirmation that
 * vanishes while they are still looking at the desktop screen tells them
 * nothing.
 */
const paired = state(null)
/*
 * Whether this device belongs to a network yet.
 *
 * Only ever a problem for a real tunnel: the stand-in needs no coordinator,
 * so an unpaired device running the simulated build is not broken and must
 * not be told it is.
 */
const network = state(null)

onMount(() => {
  // The app's name, rather than `connect` — the host titles a screen with its
  // route name, and a route name is a filename.
  navigation.setOptions({ title: 'BuddyVPN', largeTitle: true })
  const stop = tunnel.subscribe(next => snapshot.set(next))
  /*
   * Re-read the choice each time this screen comes back to the front.
   *
   * Pushing the picker does not unmount this screen, so its setup does not
   * run again when the stack pops back — the region read at mount would stay
   * whatever it was when the app started, and picking a different location
   * would change the stored value and nothing on screen.
   */
  const unwatch = navigation.onAppear(() => region.set(readRegion()))

  /*
   * Connect on open, if that is what was asked for.
   *
   * Once per launch, not once per appearance: `onAppear` also fires when the
   * picker pops back, and reconnecting because somebody looked at the
   * location list and changed their mind is not what the setting says.
   *
   * Guarded on the tunnel being idle and the region having a server, for the
   * same reason the button is — an automatic attempt that fails at the
   * prompt is worse than one that was never made.
   */
  if (readSettings().autoConnect && phase() === 'idle' && deployed())
    void tunnel.connect(region())
  // Asked here rather than at setup: Craft installs its bridge after the
  // document starts, so the answer at setup is "no" even on a phone.
  void whenNativeHost().then(value => native.set(value))

  /*
   * A pairing code, from either of the two moments it can arrive.
   *
   * `initial` is the link that launched the app, which is what scanning a
   * code off a desktop screen does when the app was closed — the common
   * case, and the one a listener alone would miss. `onLink` is the same
   * thing arriving while the app is already open.
   */
  const refreshPairing = () => { void readPairing().then(found => network.set(found)) }

  const take = (url) => {
    void applyPairingUrl(url, (id) => {
      writeRegion(id)
      region.set(readRegion())
    }).then((outcome) => {
      if (outcome) paired.set(outcome)
      refreshPairing()
    })
  }
  refreshPairing()
  void deepLinks.initial().then(take)
  const unlink = deepLinks.onLink(take)
  return () => {
    unlink()
    unwatch()
    stop()
  }
})

const here = () => regionById(region()) 
/*
 * Where the tunnel is, as opposed to where the picker points.
 *
 * Normally the same thing, and the exception is the one that matters: a
 * pairing code arriving while a tunnel is up rewrites the choice, because
 * somebody who scanned a code for Germany meant Germany. The tunnel does not
 * move — it is still carrying traffic through whichever exit it connected
 * to — so reading the picker would put a city and an address on screen that
 * the traffic is not using. Under the words "would leave from".
 *
 * `region` is in the status frame for exactly this, and was going unread.
 * Falling back to the picker covers the frame having none, which is every
 * phase but connected.
 */
const running = () => regionById(snapshot().region) ?? here()
const phase = () => snapshot().phase
const connected = () => phase() === 'connected'
const busy = () => phase() === 'connecting' || phase() === 'disconnecting'
// A location with no server behind it is not connectable, and the button says
// so by being unavailable rather than by failing after a tap.
const deployed = () => Boolean(here()?.exitIp)

/*
 * A device that has a real tunnel but no network to join cannot connect, and
 * saying so before the tap beats failing after it. The stand-in needs no
 * coordinator, so this is never true of a simulated build.
 */
const unpaired = () => tunnel.available() && network() === null

/*
 * What the coordinator is doing, when it is worth saying.
 *
 * The wording lives in `src/tunnel.ts`, where it can be tested: a bound
 * expression leaves no trace in the rendered document until its condition
 * holds, so a sentence written here could only ever be checked by reading
 * it. This screen decides *where* it goes.
 */
const notice = () => coordinatorNotice(snapshot().coordinator, running()?.country ?? null)

const statusLabel = () => {
  if (snapshot().error) return 'Something went wrong'
  if (phase() === 'connecting') return 'Connecting…'
  if (phase() === 'disconnecting') return 'Disconnecting…'
  return connected() ? 'Connected' : 'Not connected'
}

// Changing location mid-connection would mean tearing the tunnel down and
// building another, so the row is inert while one is up rather than offering
// a tap that quietly does that.
const openLocations = () => {
  if (connected()) return
  haptics.selection()
  navigation.push('locations')
}

// Not locked while connected, unlike the location row: nothing on that
// screen takes effect until the next connect, and it says so.
const openSettings = () => {
  haptics.selection()
  navigation.push('settings')
}

const toggle = () => {
  if (busy() || !deployed() || unpaired()) return
  haptics.impact('medium')
  if (connected()) void tunnel.disconnect()
  else void tunnel.connect(region())
}
</script>

<!--
  Native primitives by name, not HTML tags that happen to map.
  
  `<view>`, `<text>`, `<scroll-view>` and `<icon>` are stx's native
  components. The kebab spelling is not a style choice: stx resolves a tag
  by trying it as written, its kebab-to-PascalCase form, and its
  camel-to-kebab form, and the primitive is the file `ScrollView.stx`.
  `<scrollview>` yields `scrollview.stx` and `Scrollview.stx`, neither of
  which is that file — which a case-insensitive macOS disk hides and Linux
  does not, where the component resolved to nothing and took the whole
  screen with it.
  `<a>` is the one exception kept, because it is what maps to TouchableOpacity
  — a container that holds children and takes a tap, which a native Button
  cannot do.
  
  This replaces markup that rendered as native views arranged like a web page:
  `<header>` maps to SafeAreaView and was being used mid-screen, text sat where
  iOS uses a glyph, and the rows were loose cards rather than a grouped list.
  
  Styling is the class list, which the renderer compiles into Yoga styles.
  `dark:` survives; hover, focus and breakpoints do not.
-->
<view class="flex-1 bg-gray-100 dark:bg-black">
  <scroll-view class="flex-1 px-4">
    <!--
      Said at the top, permanently, and not as a dismissible notice. This
      build has no Network Extension entitlement, so there is no tunnel behind
      the control — it walks the states and moves nothing. The desktop app
      shipped a demo mode once and the whole risk it carried was somebody
      believing it.
    -->
    <!--
      What a scanned code did. Above everything, because somebody who just
      pointed a camera at a screen is looking for exactly this.
    -->
    @if(paired())
      <view class="mt-3 flex-row items-center gap-2 rounded-2xl border p-3"
        :class="paired().ok ? 'mt-3 flex-row items-center gap-2 rounded-2xl border border-green-300 bg-green-100 p-3 dark:border-green-700 dark:bg-green-950' : 'mt-3 flex-row items-center gap-2 rounded-2xl border border-red-300 bg-red-100 p-3 dark:border-red-700 dark:bg-red-950'">
        <text class="flex-1 text-xs"
          :class="paired().ok ? 'flex-1 text-xs text-green-800 dark:text-green-300' : 'flex-1 text-xs text-red-800 dark:text-red-300'"
          :text="paired().message"></text>
      </view>
    @endif

    @if(snapshot().simulated)
      <view class="mt-3 flex-row items-center gap-2 rounded-2xl border border-orange-300 bg-orange-100 p-3 dark:border-orange-700 dark:bg-orange-950">
        <icon class="i-lucide-triangle-alert shrink-0 text-base text-orange-700 dark:text-orange-300"></icon>
        <text class="flex-1 text-xs text-orange-700 dark:text-orange-300">Simulated — this build has no VPN entitlement, so nothing is routed.</text>
      </view>
    @endif

    <view class="items-center pt-8">
      <!--
        A bound class rather than a `data-tone` attribute: there is no CSS to
        read an attribute, and the host recompiles this class list when the
        expression changes.
      -->
      <text
        class="text-3xl font-bold text-gray-900 dark:text-gray-50"
        :class="connected() ? 'text-3xl font-bold text-green-700 dark:text-green-400' : 'text-3xl font-bold text-gray-900 dark:text-gray-50'"
        :text="statusLabel()"
      ></text>
      @if(connected())
        <text class="pt-1 text-base text-gray-500 dark:text-gray-400" :text="formatUptime(snapshot().uptimeSeconds)"></text>
      @endif
    </view>

    <!--
      Where the traffic would leave from. The desktop app asks the internet
      what address it sees, which is evidence; the phone has no tunnel to ask
      through, so this is the location's claim and is worded as one.

      The claim is about the region the *tunnel* is on, not the one the picker
      shows. See `running()`: a pairing code can change the picker while a
      tunnel is up, and this block is the one place that difference would be
      a lie rather than a mismatch.
    -->
    @if(connected())
      <view class="items-center gap-1 pt-4">
        <text class="text-xs uppercase tracking-wide text-gray-400">Would leave from</text>
        <text class="text-sm font-medium text-gray-900 dark:text-gray-100" :text="running()?.city"></text>
        <text class="text-xs text-gray-500 dark:text-gray-400" :text="running()?.exitIp"></text>
      </view>
    @endif

    <view class="items-center justify-center gap-5 py-12">
      <!--
        A circle holding an SF Symbol. The symbol is most of what makes this
        read as an iOS control rather than a styled div: `i-lucide-shield`
        resolves to the system `shield` glyph, and swapping the class swaps the
        glyph, because the host re-resolves it when the class list changes.
      -->
      <a
        class="h-44 w-44 items-center justify-center rounded-full bg-blue-600"
        :class="(!deployed() || unpaired()) ? 'h-44 w-44 items-center justify-center rounded-full bg-gray-300 dark:bg-gray-700' : busy() ? 'h-44 w-44 items-center justify-center rounded-full bg-gray-400' : connected() ? 'h-44 w-44 items-center justify-center rounded-full bg-red-600' : 'h-44 w-44 items-center justify-center rounded-full bg-blue-600'"
        :aria-label="connected() ? 'Disconnect' : 'Connect'"
        @click="toggle"
      >
        <!--
          A transport control, not a badge.

          This was a shield, and a shield is a picture of what the app is for
          rather than of what the button does. It also had to carry the state
          twice over: a tick appeared inside it while connected, under the
          word "Connected", beside a running clock — three ways of saying one
          thing, and the circle was the least legible of them.

          Play and stop say what the tap does and nothing else, which leaves
          the colour free to be the action's: red here is the same red as
          Forget and Reset, not a verdict on a connected tunnel.

          `symbol` is set outright. The class names a lucide icon that the
          renderer maps to an SF Symbol, and `square` maps to the outline —
          next to a filled play triangle that reads as a mismatched pair
          rather than a set. An explicit symbol wins over the mapping, and
          `stop.fill` is the one Apple ships for this.
        -->
        <!--
          Two elements, not one with a bound class.

          A `:class` that swaps one icon for another changes nothing on
          screen: the symbol is resolved once, and a bound class change
          re-applies colour and size without re-resolving the glyph. It
          compiled, it bound, and the icon simply never changed — visible
          only by looking at the device.

          Complementary conditions rather than `@if`/`@else`, which blanks the
          screen at hydration on this renderer.
        -->
        @if(connected())
          <icon class="i-lucide-square text-6xl text-white" symbol="stop.fill"></icon>
        @endif
        @if(!connected())
          <icon class="i-lucide-play text-6xl text-white" symbol="play.fill"></icon>
        @endif
      </a>

      @if(!deployed())
        <text class="text-center text-sm text-gray-500 dark:text-gray-400" :text="`No server in ${here()?.country ?? 'this location'} yet`"></text>
      @endif
      @if(deployed())
        <text class="text-center text-sm text-gray-500 dark:text-gray-400" :text="connected() ? 'Tap to disconnect' : `Tap to connect to ${here()?.country}`"></text>
      @endif
    </view>

    <!--
      The reason, not just that there was one.

      The status line can only say "Something went wrong", and the provider's
      messages are the useful part: not allowed to add a VPN configuration,
      no coordinator to join, a server that stopped answering. Dropping them
      leaves somebody with a button that does not work and nothing to do
      about it.
    -->
    @if(snapshot().error)
      <view class="mb-3 rounded-2xl border border-red-300 bg-red-100 p-3 dark:border-red-700 dark:bg-red-950">
        <text class="text-xs text-red-800 dark:text-red-300" :text="snapshot().error"></text>
      </view>
    @endif

    <!--
      The coordinator, when it has something to say.

      Above the location rows and below the button, where the error banner
      sits, because it is the same kind of thing: a sentence about why the
      thing you just looked at is not what it appears to be. Two tones, since
      one of these is waiting and the other needs somebody to do something.

      Complementary conditions rather than `@if`/`@else`, which blanks the
      screen at hydration on this renderer.
    -->
    @if(notice())
      <view class="mb-3 flex-row items-center gap-2 rounded-2xl border p-3"
        :class="notice().tone === 'error' ? 'mb-3 flex-row items-center gap-2 rounded-2xl border border-red-300 bg-red-100 p-3 dark:border-red-700 dark:bg-red-950' : 'mb-3 flex-row items-center gap-2 rounded-2xl border border-amber-300 bg-amber-100 p-3 dark:border-amber-700 dark:bg-amber-950'">
        <icon class="i-lucide-unplug shrink-0 text-base text-amber-700 dark:text-amber-300"
          :class="notice().tone === 'error' ? 'i-lucide-octagon-alert shrink-0 text-base text-red-700 dark:text-red-300' : 'i-lucide-unplug shrink-0 text-base text-amber-700 dark:text-amber-300'"></icon>
        <text class="flex-1 text-xs text-amber-800 dark:text-amber-300"
          :class="notice().tone === 'error' ? 'flex-1 text-xs text-red-800 dark:text-red-300' : 'flex-1 text-xs text-amber-800 dark:text-amber-300'"
          :text="notice().message"></text>
      </view>
    @endif

    <!--
      Said before the tap rather than after it. A device with a real tunnel
      and no network to join cannot connect, and a button that fails is a
      worse way to find that out than a sentence saying what to do.
    -->
    @if(unpaired())
      <view class="mb-3 rounded-2xl border border-orange-300 bg-orange-100 p-3 dark:border-orange-700 dark:bg-orange-950">
        <text class="text-xs text-orange-700 dark:text-orange-300">This device is not part of a network yet. Open BuddyVPN on your Mac and point this phone's camera at the pairing code in its settings.</text>
      </view>
    @endif

    <!--
      An inset grouped list: a section header above a rounded block of rows.
      That shape is what iOS uses for settings, and it is the difference
      between a row you can open and a card sitting on a page.

      Locked while a tunnel is up, for the same reason the desktop app locks
      it: changing location mid-connection is a disconnect and a fresh
      handshake, and a row that silently means that is a row that lies.
    -->
    <text class="px-1 pb-2 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Location</text>
    <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      <a
        class="flex-row items-center gap-3 px-4 py-3"
        :class="connected() ? 'flex-row items-center gap-3 px-4 py-3 opacity-50' : 'flex-row items-center gap-3 px-4 py-3'"
        :aria-disabled="connected() ? 'true' : 'false'"
        @click="openLocations"
      >
        <icon class="i-lucide-map-pin shrink-0 text-base text-gray-400"></icon>
        <text class="shrink-0 text-base text-gray-900 dark:text-gray-100" :text="here()?.country"></text>
        <text class="flex-1 text-right text-sm text-gray-500 dark:text-gray-400" :text="here()?.city"></text>
        <icon class="i-lucide-chevron-right shrink-0 text-base text-gray-400"></icon>
      </a>
    </view>

    <!--
      Its own block rather than a second row under LOCATION, because that
      header would then be describing one of the two rows beneath it. A
      row that pushes a screen is the same control as the one above; only
      the grouping differs.
    -->
    <view class="mt-4 overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      <a class="flex-row items-center gap-3 px-4 py-3" @click="openSettings">
        <icon class="i-lucide-settings shrink-0 text-base text-gray-400"></icon>
        <text class="flex-1 text-base text-gray-900 dark:text-gray-100">Settings</text>
        <icon class="i-lucide-chevron-right shrink-0 text-base text-gray-400"></icon>
      </a>
    </view>

    @if(native())
      <text class="py-6 text-center text-xs text-gray-400">Running in a native shell.</text>
    @endif
  </scroll-view>
</view>
