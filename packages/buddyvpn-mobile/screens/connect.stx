<script client>
import { haptics, whenNativeHost } from '../src/native'
import { DEFAULT_REGION, regionById } from '../src/regions'
import { formatUptime, tunnel } from '../src/tunnel'

// The chosen location outlives a screen, so it is read back rather than
// defaulted on every mount — otherwise walking to the picker and back would
// silently reset it.
const stored = (() => {
  try {
    return window.localStorage?.getItem('buddyvpn.region')
  }
  catch {
    // Private windows and cleared site data both throw rather than return
    // null. A missing preference is not an error.
    return null
  }
})()

const region = state(regionById(stored) ? stored : DEFAULT_REGION)
const snapshot = state(tunnel.snapshot())
const native = state(false)

onMount(() => {
  const stop = tunnel.subscribe(next => snapshot.set(next))
  // Asked here rather than at setup: Craft installs its bridge after the
  // document starts, so the answer at setup is "no" even on a phone.
  void whenNativeHost().then(value => native.set(value))
  return stop
})

const here = () => regionById(region()) 
const phase = () => snapshot().phase
const connected = () => phase() === 'connected'
const busy = () => phase() === 'connecting' || phase() === 'disconnecting'
// A location with no server behind it is not connectable, and the button says
// so by being unavailable rather than by failing after a tap.
const deployed = () => Boolean(here()?.exitIp)

const statusLabel = () => {
  if (snapshot().error) return 'Something went wrong'
  if (phase() === 'connecting') return 'Connecting…'
  if (phase() === 'disconnecting') return 'Disconnecting…'
  return connected() ? 'Connected' : 'Not connected'
}

const toggle = () => {
  if (busy() || !deployed()) return
  haptics.impact('medium')
  if (connected()) void tunnel.disconnect()
  else void tunnel.connect(region())
}
</script>

<!--
  Styling is utility classes, not a stylesheet.

  A native screen has no CSS: the renderer compiles the class list into Yoga
  styles through its own Tailwind-shaped mapping, and a class it does not
  recognise is dropped in silence. `app.css` therefore styled nothing here —
  which is why this screen first rendered as unstyled text with no button
  visible, and why nothing warned about it.

  `dark:` is the one variant that survives, because the host knows the
  appearance. Hover, focus and breakpoints have no meaning on a phone and are
  discarded.
-->
<div class="flex flex-1 flex-col gap-4 bg-gray-100 px-5 pb-5 dark:bg-black" :data-phase="phase()">
  <!--
    Said at the top, permanently, and not as a dismissible notice.

    This build has no Network Extension entitlement, so there is no tunnel
    behind the button — it walks the states and moves nothing. The desktop app
    shipped a demo mode once and the whole risk it carried was somebody
    believing it, so this is the first thing on the screen rather than a
    footnote under the fold.
  -->
  @if(snapshot().simulated)
    <p
      class="mt-3 rounded-xl border border-orange-300 bg-orange-100 p-3 text-center text-xs text-orange-700 dark:border-orange-700 dark:bg-orange-950 dark:text-orange-300"
      role="status"
    >
      Simulated — this build has no VPN entitlement, so nothing is routed.
    </p>
  @endif

  <header class="items-center pt-4">
    <!--
      The colour is a bound class, not an attribute a stylesheet would have
      read: `data-tone` selects nothing when there is no CSS. The runtime
      recompiles this class list when the expression changes.
    -->
    <h1
      class="text-2xl font-bold text-gray-900 dark:text-gray-50"
      :class="connected() ? 'text-2xl font-bold text-green-700 dark:text-green-400' : 'text-2xl font-bold text-gray-900 dark:text-gray-50'"
      :text="statusLabel()"
    ></h1>
    @if(connected())
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400" :text="formatUptime(snapshot().uptimeSeconds)"></p>
    @endif
  </header>

  <!--
    Where the traffic would leave from. The desktop app asks the internet what
    address it sees, which is evidence; the phone has no tunnel to ask
    through, so this is the location's claim and is worded as one.
  -->
  @if(connected())
    <div class="items-center gap-1">
      <span class="text-xs font-semibold uppercase text-gray-400">Would leave from</span>
      <span class="text-sm font-medium text-gray-900 dark:text-gray-100" :text="here()?.city"></span>
      <span class="text-xs text-gray-500 dark:text-gray-400" :text="here()?.exitIp"></span>
    </div>
  @endif

  <div class="flex flex-1 flex-col items-center justify-center gap-4">
    <!--
      The button is markup here rather than a component.

      A component's props are evaluated once, server-side, while the page is
      rendered — `phase="{{ phase() }}"` reaches it as the empty string and
      never changes again. Anything that has to react must read the screen's
      own signals, and a component file that silently depends on its caller's
      scope is harder to trust than the markup being where its state is.

      It says what pressing it does rather than what the state is: the label
      above already reads "Connected", so a power glyph on a live connection
      would leave the only question this control answers unanswered.
    -->
    <button
      type="button"
      class="h-48 w-48 items-center justify-center rounded-full bg-blue-600 text-white"
      :class="!deployed() ? 'h-48 w-48 items-center justify-center rounded-full bg-gray-300 text-white dark:bg-gray-700' : busy() ? 'h-48 w-48 items-center justify-center rounded-full bg-gray-400 text-white' : connected() ? 'h-48 w-48 items-center justify-center rounded-full bg-red-600 text-white' : 'h-48 w-48 items-center justify-center rounded-full bg-blue-600 text-white'"
      :aria-busy="busy() ? 'true' : 'false'"
      :aria-label="connected() ? 'Disconnect' : 'Connect'"
      @click="toggle"
      :title="connected() ? 'Stop' : 'Start'"
    ></button>

    <!--
      Two complementary conditions, not an `@if`/`@else`.

      An `@else` in this position compiles, renders nothing, and takes the
      whole screen down with it at runtime:

        [stx] effect error (the effect is disposed):
        undefined is not an object (evaluating 'D.__stx_detached_if')

      The screen went blank — not the missing caption it was meant to fix.

      Two elements under the condition, not two spans inside one paragraph.
      A `<p>` becomes a Text node, and inline children of a Text node are
      flattened into its own words — the binding goes with the structure, so
      the caption rendered as nothing at all.
    -->
    @if(!deployed())
      <p class="text-center text-sm text-gray-500 dark:text-gray-400" :text="`No server in ${here()?.country ?? 'this location'} yet`"></p>
    @endif
    @if(deployed())
      <p class="text-center text-sm text-gray-500 dark:text-gray-400" :text="connected() ? 'Tap to disconnect' : `Tap to connect to ${here()?.country}`"></p>
    @endif
  </div>

  <!-- Locked while a tunnel is up, for the same reason the desktop app locks
       it: changing location mid-connection is a disconnect and a fresh
       handshake, and a row that silently means that is a row that lies. -->
  <StxLink
    to="/locations"
    class="flex flex-row items-center gap-3 rounded-xl bg-white p-4 dark:bg-gray-900"
    :aria-disabled="connected() ? 'true' : 'false'"
    data-stx-nav="push"
  >
    <span class="text-xl" :text="here()?.badge"></span>
    <!--
      One level of spans, not two. Inline elements nested inside another are
      flattened into their parent's text — the compiler says so as
      `flattened-text` — and the bindings inside them are lost with the
      structure. That is why the country and city were missing while the badge
      beside them rendered.
    -->
    <span class="flex-1 text-xs font-semibold uppercase text-gray-400" :text="connected() ? 'Location · disconnect to change' : 'Location'"></span>
    <span class="text-base font-medium text-gray-900 dark:text-gray-100" :text="here()?.country"></span>
    <span class="text-sm text-gray-500 dark:text-gray-400" :text="here()?.city"></span>
  </StxLink>

  @if(native())
    <p class="text-center text-xs text-gray-400">Running in a native shell.</p>
  @endif
</div>
