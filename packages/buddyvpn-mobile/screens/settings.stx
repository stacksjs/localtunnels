<script server>
/*
 * Server-side for the same reason the locations list is: a client `@for`
 * cannot draw a list on the native renderer — the runtime finds lists with
 * `el.hasAttribute('@for')`, which a native node does not implement. The
 * resolvers are fixed when the app is built, so expanding here costs nothing
 * and produces one real row each, carrying its own bindings for the part
 * that does change.
 */
import { DNS_LABELS, DNS_PRESETS } from '../src/settings'

const RESOLVERS = Object.keys(DNS_PRESETS).map(id => ({
  id,
  label: DNS_LABELS[id],
  servers: DNS_PRESETS[id].join(', '),
}))
</script>

<script client>
import { haptics, navigation } from '../src/native'
import { readSettings, writeSettings } from '../src/settings'

const settings = state(readSettings())

onMount(() => {
  navigation.setOptions({ title: 'Settings', largeTitle: true })
  // Re-read when the screen comes back to the front, for the same reason the
  // connect screen does: a pushed screen leaves this one mounted, so setup
  // does not run again and anything read once would be stale from then on.
  return navigation.onAppear(() => settings.set(readSettings()))
})

const dns = () => settings().dns
const allowLan = () => settings().allowLan
const autoConnect = () => settings().autoConnect

const chooseDns = (id: string) => {
  if (id === dns()) return
  haptics.selection()
  settings.set(writeSettings({ dns: id as ReturnType<typeof dns> }))
}

const toggleLan = () => {
  haptics.selection()
  settings.set(writeSettings({ allowLan: !allowLan() }))
}

const toggleAutoConnect = () => {
  haptics.selection()
  settings.set(writeSettings({ autoConnect: !autoConnect() }))
}
</script>

<view class="flex-1 bg-gray-100 dark:bg-black">
  <scrollview class="flex-1 px-4">
    <!--
      A resolver is chosen from a list with a checkmark on the current one,
      not from a `<picker>`. A picker on iOS is a spinning wheel, which is
      what you reach for with thirty options and not with three — Settings
      itself uses a checked list for a choice this size.
    -->
    <text class="px-1 pb-2 pt-2 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">DNS</text>
    <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      @foreach(RESOLVERS as resolver)
        <a
          class="flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 dark:border-gray-800"
          @click="chooseDns('{{ resolver.id }}')"
        >
          <view class="flex-1">
            <text class="text-base text-gray-900 dark:text-gray-100">{{ resolver.label }}</text>
            <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">{{ resolver.servers }}</text>
          </view>
          <!--
            Two complementary conditions rather than `@if`/`@else`, which
            blanks the screen at hydration on this renderer, and a second
            element rather than a bound class, because a symbol is resolved
            from the class list and a bound change re-applies colour without
            re-resolving the glyph.
          -->
          @if(dns() === '{{ resolver.id }}')
            <icon class="i-lucide-check shrink-0 text-base text-blue-600"></icon>
          @endif
          @if(dns() !== '{{ resolver.id }}')
            <view class="h-4 w-4 shrink-0"></view>
          @endif
        </a>
      @endforeach
    </view>
    <text class="px-1 py-2 text-xs text-gray-500 dark:text-gray-400">
      Used while connected. A change takes effect on the next connect.
    </text>

    <text class="px-1 pb-2 pt-4 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Connection</text>
    <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      <view class="flex-row items-center gap-3 px-4 py-3">
        <view class="flex-1">
          <text class="text-base text-gray-900 dark:text-gray-100">Allow local network</text>
          <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">Reach printers and other machines at home.</text>
        </view>
        <switch class="shrink-0" :value="allowLan()" @change="toggleLan"></switch>
      </view>
      <view class="flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 dark:border-gray-800">
        <view class="flex-1">
          <text class="text-base text-gray-900 dark:text-gray-100">Connect on open</text>
          <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">Start the tunnel as soon as the app opens.</text>
        </view>
        <switch class="shrink-0" :value="autoConnect()" @change="toggleAutoConnect"></switch>
      </view>
    </view>

    <!--
      Said rather than left to be noticed, which is what the desktop app's
      settings screen does with the same two.
    -->
    <text class="px-1 pb-2 pt-6 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Not settings</text>
    <view class="rounded-2xl bg-white p-4 dark:bg-gray-900">
      <text class="text-xs leading-5 text-gray-500 dark:text-gray-400">
        The kill switch and full-tunnel mode are always on. An app whose purpose is to put your traffic somewhere else has no honest setting for "but not really", and a kill switch that is off by default protects only the people who already knew to turn it on.
      </text>
    </view>

    <view class="h-8"></view>
  </scrollview>
</view>
