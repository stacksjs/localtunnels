<script server>
/*
 * Server-side for the same reason the locations list is: a client `@for`
 * cannot draw a list on the native renderer — the runtime finds lists with
 * `el.hasAttribute('@for')`, which a native node does not implement. The
 * resolvers are fixed when the app is built, so expanding here costs nothing
 * and produces one real row each, carrying its own bindings for the part
 * that does change.
 */
import { DNS_LABELS, DNS_PRESETS } from '../src/settings'

const RESOLVERS = Object.keys(DNS_PRESETS).map(id => ({
  id,
  label: DNS_LABELS[id],
  servers: DNS_PRESETS[id].join(', '),
}))
</script>

<script client>
import { deepLinks, haptics, navigation } from '../src/native'
import { applyPairingUrl, describePairing, forgetPairing, readPairing } from '../src/pairing'
import { writeRegion } from '../src/regions'
import { readSettings, writeSettings } from '../src/settings'
import { tunnel } from '../src/tunnel'

const settings = state(readSettings())
/*
 * The network this device belongs to, or null.
 *
 * Read asynchronously because it lives in the Keychain, which is where a
 * shared secret belongs and which has no synchronous read. The screen draws
 * "not paired" until the answer arrives, which is the honest thing to show
 * while nothing is known.
 */
const pairing = state(null)
/*
 * What the coordinator calls this device.
 *
 * Comes from the tunnel rather than from storage: the key lives in a
 * Keychain group the extension owns, and the screens learn about it the way
 * they learn everything else about the tunnel. The stand-in has none,
 * because it joins nothing and so is known by nobody.
 */
const device = state(tunnel.deviceKey())
/*
 * What a code scanned on this screen did.
 *
 * This screen listens for codes because it is the screen that asks for one:
 * the row above says to open BuddyVPN on the Mac and point the camera at
 * the pairing code, and somebody who does that is looking at this screen
 * when the link arrives. Craft delivers a link only to the screen on top of
 * the stack, so without this the code lands on a screen that is not
 * listening and nothing at all happens — which is what the words on this
 * screen had just told somebody to do.
 */
const scanned = state(null)

onMount(() => {
  navigation.setOptions({ title: 'Settings', largeTitle: true })
  const refresh = () => { void readPairing().then(found => pairing.set(found)) }
  refresh()
  const stop = tunnel.subscribe(() => device.set(tunnel.deviceKey()))
  // Re-read when the screen comes back to the front, for the same reason the
  // connect screen does: a pushed screen leaves this one mounted, so setup
  // does not run again and anything read once would be stale from then on.
  const unwatch = navigation.onAppear(() => settings.set(readSettings()))
  /*
   * Links arriving while this screen is up. Not `initial`: the link the app
   * was launched with belongs to the first screen, which claims it once, and
   * asking for it again here would answer null on a good day and take it
   * from the connect screen on a bad one.
   */
  const unlink = deepLinks.onLink((url) => {
    void applyPairingUrl(url, writeRegion).then((outcome) => {
      if (outcome)
        scanned.set(outcome)
      refresh()
    })
  })
  return () => {
    unlink()
    unwatch()
    stop()
  }
})

const dns = () => settings().dns
const allowLan = () => settings().allowLan
const autoConnect = () => settings().autoConnect

const chooseDns = (id: string) => {
  if (id === dns()) return
  haptics.selection()
  settings.set(writeSettings({ dns: id as ReturnType<typeof dns> }))
}

const toggleLan = () => {
  haptics.selection()
  settings.set(writeSettings({ allowLan: !allowLan() }))
}

const hasDevice = () => device() !== null
/** Enough of the key to compare against a server's list, not all of it. */
const deviceShort = () => `${(device() ?? '').slice(0, 16)}…`

/*
 * A new key is a new device to the coordinator: a fresh address, and
 * whatever the old key was allowed stays allowed until somebody removes it
 * there. The answer to a key that has been somewhere it should not have
 * been, and nothing smaller — which is why it says so next to the button.
 */
const resetDevice = () => {
  haptics.impact('medium')
  void tunnel.forgetIdentity()
}

const paired = () => pairing() !== null
const pairedWith = () => describePairing(pairing())

/*
 * Forgetting a network is what this device can do about a key it should no
 * longer hold — a phone that was lost, a secret that was rotated, a network
 * somebody left. Without a coordinator there is nothing to connect to, so
 * this is the whole of unpairing from the device's side.
 *
 * It does not reach the coordinator, which has no notion of revoking one
 * member: anyone still holding the key can still join. Saying that where
 * somebody is about to rely on it matters more than the button does.
 */
const forget = () => {
  haptics.selection()
  // Both copies. The screens' own is in this process's Keychain; the
  // tunnel's is in the group it shares with the extension, and a pairing
  // forgotten here while that one survives is a device that still holds the
  // secret it was told to forget.
  void tunnel.forgetPairing()
  void forgetPairing().then(() => pairing.set(null))
}

const toggleAutoConnect = () => {
  haptics.selection()
  settings.set(writeSettings({ autoConnect: !autoConnect() }))
}
</script>

<view class="flex-1 bg-gray-100 dark:bg-black">
  <scroll-view class="flex-1 px-4">
    <!--
      A resolver is chosen from a list with a checkmark on the current one,
      not from a `<picker>`. A picker on iOS is a spinning wheel, which is
      what you reach for with thirty options and not with three — Settings
      itself uses a checked list for a choice this size.
    -->
    <text class="px-1 pb-2 pt-2 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">DNS</text>
    <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      @foreach(RESOLVERS as resolver)
        <a
          class="flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 dark:border-gray-800"
          @click="chooseDns('{{ resolver.id }}')"
        >
          <view class="flex-1">
            <text class="text-base text-gray-900 dark:text-gray-100">{{ resolver.label }}</text>
            <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">{{ resolver.servers }}</text>
          </view>
          <!--
            Two complementary conditions rather than `@if`/`@else`, which
            blanks the screen at hydration on this renderer, and a second
            element rather than a bound class, because a symbol is resolved
            from the class list and a bound change re-applies colour without
            re-resolving the glyph.
          -->
          @if(dns() === '{{ resolver.id }}')
            <icon class="i-lucide-check shrink-0 text-base text-blue-600"></icon>
          @endif
          @if(dns() !== '{{ resolver.id }}')
            <view class="h-4 w-4 shrink-0"></view>
          @endif
        </a>
      @endforeach
    </view>
    <text class="px-1 py-2 text-xs text-gray-500 dark:text-gray-400">
      Used while connected. A change takes effect on the next connect.
    </text>

    <text class="px-1 pb-2 pt-4 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Network</text>
    <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      @if(paired())
        <view class="flex-row items-center gap-3 px-4 py-3">
          <view class="flex-1">
            <text class="text-base text-gray-900 dark:text-gray-100">Paired</text>
            <!-- The host and the region. Never the key: there is no reason
                 to put a shared secret back on a screen after storing it. -->
            <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400" :text="pairedWith()"></text>
          </view>
          <a class="shrink-0 rounded-full bg-red-100 px-3 py-1 dark:bg-red-950" @click="forget">
            <text class="text-xs text-red-700 dark:text-red-300">Forget</text>
          </a>
        </view>
      @endif
      @if(!paired())
        <view class="px-4 py-3">
          <text class="text-base text-gray-900 dark:text-gray-100">Not paired</text>
          <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">Open BuddyVPN on your Mac, go to Settings, and point this phone's camera at the pairing code.</text>
        </view>
      @endif
    </view>
    <!--
      One element with a bound class, not one per tone: a `@if`/`@else` pair
      blanks the screen at hydration, and the two tones differ only in colour.
    -->
    @if(scanned())
      <view
        :class="scanned().ok ? 'mt-2 flex-row items-center gap-2 rounded-2xl border border-green-300 bg-green-100 p-3 dark:border-green-700 dark:bg-green-950' : 'mt-2 flex-row items-center gap-2 rounded-2xl border border-red-300 bg-red-100 p-3 dark:border-red-700 dark:bg-red-950'">
        <text
          :class="scanned().ok ? 'flex-1 text-xs text-green-800 dark:text-green-300' : 'flex-1 text-xs text-red-800 dark:text-red-300'"
          :text="scanned().message"></text>
      </view>
    @endif
    <text class="px-1 py-2 text-xs text-gray-500 dark:text-gray-400">
      Forgetting a network removes it from this device only. Anyone still holding its code can still join it.
    </text>

    <!--
      One element, not three siblings behind one `@if`.

      A condition here guards the element it is on; written across a header,
      a card and a note it removed one of them and left the other two, which
      is a section that half-appears on a device that has no key at all.
    -->
    @if(hasDevice())
      <view>
        <text class="px-1 pb-2 pt-4 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">This device</text>
        <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
          <view class="flex-row items-center gap-3 px-4 py-3">
            <view class="flex-1">
              <text class="text-base text-gray-900 dark:text-gray-100">Key</text>
              <!-- Enough to compare against the server's peer list, not all
                   of it: the whole key is longer than it is useful here. -->
              <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400" :text="deviceShort()"></text>
            </view>
            <a class="shrink-0 rounded-full bg-red-100 px-3 py-1 dark:bg-red-950" @click="resetDevice">
              <text class="text-xs text-red-700 dark:text-red-300">Reset</text>
            </a>
          </view>
        </view>
        <text class="px-1 py-2 text-xs text-gray-500 dark:text-gray-400">
          Resetting makes this a new device to the network. The old key keeps whatever access it had until it is removed on the server.
        </text>
      </view>
    @endif

    <text class="px-1 pb-2 pt-4 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Connection</text>
    <view class="overflow-hidden rounded-2xl bg-white dark:bg-gray-900">
      <view class="flex-row items-center gap-3 px-4 py-3">
        <view class="flex-1">
          <text class="text-base text-gray-900 dark:text-gray-100">Allow local network</text>
          <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">Reach printers and other machines at home.</text>
        </view>
        <switch class="shrink-0" :value="allowLan()" @change="toggleLan"></switch>
      </view>
      <view class="flex-row items-center gap-3 border-t border-gray-200 px-4 py-3 dark:border-gray-800">
        <view class="flex-1">
          <text class="text-base text-gray-900 dark:text-gray-100">Connect on open</text>
          <text class="pt-0.5 text-xs text-gray-500 dark:text-gray-400">Start the tunnel as soon as the app opens.</text>
        </view>
        <switch class="shrink-0" :value="autoConnect()" @change="toggleAutoConnect"></switch>
      </view>
    </view>

    <!--
      Said rather than left to be noticed, which is what the desktop app's
      settings screen does with the same two.
    -->
    <text class="px-1 pb-2 pt-6 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Not settings</text>
    <view class="rounded-2xl bg-white p-4 dark:bg-gray-900">
      <text class="text-xs leading-5 text-gray-500 dark:text-gray-400">
        The kill switch and full-tunnel mode are always on. An app whose purpose is to put your traffic somewhere else has no honest setting for "but not really", and a kill switch that is off by default protects only the people who already knew to turn it on.
      </text>
    </view>

    <view class="h-8"></view>
  </scroll-view>
</view>
