{
  "name": "localtunnels-monorepo",
  "type": "module",
  "version": "0.2.7",
  "private": true,
  "description": "A simple and smart tunneling solution. Expose your localhost to the world.",
  "author": "Chris Breuer <chris@stacksjs.com>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/localtunnels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/localtunnels.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/localtunnels/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter localtunnels build",
    "build:native": "cd packages/vpn-core && zig build",
    "test:native": "cd packages/vpn-core && zig build test",
    "compile": "bun build ./packages/localtunnels/bin/cli.ts --compile --minify --external '@stacksjs/ts-analytics' --outfile bin/localtunnels",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:windows-x64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64",
    "compile:linux-x64": "bun build ./packages/localtunnels/bin/cli.ts --compile --minify --external '@stacksjs/ts-analytics' --target=bun-linux-x64 --outfile bin/localtunnels-linux-x64",
    "compile:linux-arm64": "bun build ./packages/localtunnels/bin/cli.ts --compile --minify --external '@stacksjs/ts-analytics' --target=bun-linux-arm64 --outfile bin/localtunnels-linux-arm64",
    "compile:windows-x64": "bun build ./packages/localtunnels/bin/cli.ts --compile --minify --external '@stacksjs/ts-analytics' --target=bun-windows-x64 --outfile bin/localtunnels-windows-x64.exe",
    "compile:darwin-x64": "bun build ./packages/localtunnels/bin/cli.ts --compile --minify --external '@stacksjs/ts-analytics' --target=bun-darwin-x64 --outfile bin/localtunnels-darwin-x64",
    "compile:darwin-arm64": "bun build ./packages/localtunnels/bin/cli.ts --compile --minify --external '@stacksjs/ts-analytics' --target=bun-darwin-arm64 --outfile bin/localtunnels-darwin-arm64",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "changelog": "bunx changelogen --output CHANGELOG.md",
    "release": "bun --bun run changelog && bunx --bun bumpp package.json packages/*/package.json --all",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit --project tsconfig.json",
    "dev:docs": "bun --bun bunpress dev docs",
    "build:docs": "bun --bun bunpress build docs",
    "preview:docs": "bun --bun bunpress preview docs",
    "zip": "bun run zip:all",
    "zip:all": "bun run zip:linux-x64 && bun run zip:linux-arm64 && bun run zip:windows-x64 && bun run zip:darwin-x64 && bun run zip:darwin-arm64",
    "zip:linux-x64": "zip -j bin/localtunnels-linux-x64.zip bin/localtunnels-linux-x64",
    "zip:linux-arm64": "zip -j bin/localtunnels-linux-arm64.zip bin/localtunnels-linux-arm64",
    "zip:windows-x64": "zip -j bin/localtunnels-windows-x64.zip bin/localtunnels-windows-x64.exe",
    "zip:darwin-x64": "zip -j bin/localtunnels-darwin-x64.zip bin/localtunnels-darwin-x64",
    "zip:darwin-arm64": "zip -j bin/localtunnels-darwin-arm64.zip bin/localtunnels-darwin-arm64",
    "deploy": "bun run deploy:site && bun run deploy:tunnel && bun run deploy:analytics",
    "deploy:site": "bun run build:docs && bun run packages/localtunnels/bin/cli.ts deploy:site",
    "deploy:tunnel": "bun run packages/localtunnels/bin/cli.ts deploy:tunnel",
    "deploy:analytics": "bun run packages/localtunnels/bin/cli.ts deploy:analytics",
    "deploy:vpn": "bun run deploy/vpn.ts",
    "verify:vpn": "bun run deploy/verify.ts",
    "destroy:vpn": "bun run deploy/destroy-vpn.ts",
    "destroy": "bun run packages/localtunnels/bin/cli.ts destroy",
    "destroy:analytics": "bun run packages/localtunnels/bin/cli.ts destroy:analytics",
    "server": "bun run packages/localtunnels/bin/cli.ts server",
    "client": "bun run packages/localtunnels/bin/cli.ts start",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write"
  },
  "devDependencies": {
    "@stacksjs/bunpress": "^0.1.1",
    "@stacksjs/ts-cloud": "^0.7.7",
    "better-dx": "^0.2.15",
    "mitata": "^1.0.34",
    "pickier": "^0.1.37"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      },
      "autoRestage": true
    },
    "commit-msg": "bunx gitlint .git/COMMIT_EDITMSG"
  }
}
